---
import Base from '../../layouts/Base.astro';
import { STATES, ft, sgn, cls, lakeUrl } from '../../lib/lakes';
export function getStaticPaths() { return STATES.map((s) => ({ params: { state: s.slug }, props: { s } })); }
const { s } = Astro.props as { s: (typeof STATES)[number] };
const ls = s.lakes;
const withPf = ls.filter((l) => l.pf != null && l.capacity);
const statePf = withPf.length ? withPf.reduce((a, l) => a + l.pf! * l.capacity!, 0) / withPf.reduce((a, l) => a + l.capacity!, 0) : null;
const rising = ls.filter((l) => l.trend === 'rising'), falling = ls.filter((l) => l.trend === 'falling');
const steady = ls.length - rising.length - falling.length;
const lowest = withPf.length ? [...withPf].sort((a, b) => a.pf! - b.pf!)[0] : null;
const fullest = withPf.length ? [...withPf].sort((a, b) => b.pf! - a.pf!)[0] : null;
const big = [...ls].sort((a, b) => Math.abs(b.ch7 ?? 0) - Math.abs(a.ch7 ?? 0))[0];
const isAre = (n: number) => (n === 1 ? 'is' : 'are');
const title = `${s.name} Lake Levels Today: ${ls.length} ${ls.length === 1 ? 'Lake' : 'Lakes'}${statePf != null ? `, ${ft(statePf, 0)}% Full` : ''} | LakeLevelData`;
const schema = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Lake levels', item: new URL('/', Astro.site).href },
  { '@type': 'ListItem', position: 2, name: `${s.name} lake levels`, item: new URL(`/${s.slug}/`, Astro.site).href }] }];
---
<Base title={title} description={`Current water levels for ${ls.length} ${s.name} lakes and reservoirs from official gauges: today's elevation, 7-day change${statePf != null ? ' and percent full' : ''}.`} schema={schema}>
  <p class="crumbs"><a href="/">Lake levels</a> › {s.name}</p>
  <h1>{s.name} lake levels today</h1>
  <p class="answer">{statePf != null && <>The {withPf.length} {s.name} reservoirs listed here are <strong>{ft(statePf, 1)}% full</strong> combined (weighted by capacity). </>}
    Over the past week {rising.length} {isAre(rising.length)} rising, {falling.length} {isAre(falling.length)} falling and {steady} {isAre(steady)} steady.
    {big && big.ch7 != null && Math.abs(big.ch7) >= 0.1 && <> The biggest weekly move is at <a href={lakeUrl(big)}>{big.name}</a> ({sgn(big.ch7)}).</>}</p>
  {lowest && fullest && lowest !== fullest && <p>Lowest by storage: <a href={lakeUrl(lowest)}>{lowest.name}</a> at {ft(lowest.pf, 1)}% full. Fullest: <a href={lakeUrl(fullest)}>{fullest.name}</a> at {ft(fullest.pf, 1)}%.</p>}
  <div class="scroll"><table>
    <tr><th>Lake</th><th class="num">Level (ft)</th><th class="num">24 h</th><th class="num">7 days</th><th class="num">vs 1 yr</th><th class="num">Full</th></tr>
    {ls.map((l) => <tr><td><a href={lakeUrl(l)}>{l.name}</a></td><td class="num">{ft(l.now)}</td><td class={`num ${cls(l.ch1)}`}>{sgn(l.ch1)}</td><td class={`num ${cls(l.ch7)}`}>{sgn(l.ch7)}</td><td class={`num ${cls(l.ch365)}`}>{sgn(l.ch365)}</td><td class="num">{l.pf != null ? `${ft(l.pf, 1)}%` : l.vs_full != null ? sgn(l.vs_full, 1) : l.vs_guide != null ? `${sgn(l.vs_guide, 1)} vs guide` : '–'}</td></tr>)}
  </table></div>
  <p class="muted">Sources: {[...new Set(ls.map((l) => l.agency))].join(', ')}. See <a href="/sources/">how the data is collected</a>.</p>
</Base>
